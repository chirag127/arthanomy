{
  "name": "arthanomy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arthanomy — The Science of Wealth. A source-driven Indian investment, taxation and wealth intelligence library.",
  "author": "Chirag Singhal <chirag@oriz.in>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "prebuild": "node scripts/generate-book.mjs",
    "build:site": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,mjs,json,md,mdx,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,mjs,json,md,mdx,css,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pdf": "node scripts/generate-pdfs.mjs",
    "test:e2e:install": "playwright install --with-deps chromium",
    "validate:content": "vitest run tests/registries.test.ts",
    "validate:links": "node scripts/audit-internal-links/index.mjs",
    "content:status": "node scripts/content-pipeline/manifest.mjs",
    "content:plan": "node scripts/content-pipeline/build-reading-order.mjs",
    "content:packets": "node scripts/content-pipeline/export-packets.mjs",
    "content:batches": "node scripts/content-pipeline/batches.mjs",
    "content:audit": "node scripts/content-pipeline/audit-articles.mjs",
    "content:links": "node scripts/content-pipeline/link-queued.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@pagefind/default-ui": "^1.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "astro": "^7.4.0",
    "echarts": "^6.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.58.0",
    "mermaid": "^12.2.0",
    "pagefind": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.1.0",
    "vitest": "^5.0.5"
  }
}
