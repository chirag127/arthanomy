---
/**
 * /roadmap — the full research plan, openly tracked.
 *
 * Shows every brief the library is built from, its queue status, and — for
 * completed ones — a link to the published article. Nothing is stubbed:
 * a brief exists until an article exists, and the two are never conflated.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, categoryMeta } from '../../config/site';
import { href, articleHref } from '../../lib/url';
import { formatCount } from '../../lib/format';

const [briefs, articles] = await Promise.all([
  getCollection('roadmap'),
  getCollection('articles', ({ data }) => !data.draft),
]);

const publishedIds = new Set(articles.map((a) => a.id));

const groups = categories
  .map((cat) => ({
    cat,
    briefs: briefs
      .filter((b) => b.data.category === cat.id)
      .sort((a, b) => a.data.priority - b.data.priority || a.data.title.localeCompare(b.data.title)),
  }))
  .filter((group) => group.briefs.length > 0);

const writtenTotal = briefs.filter((b) => publishedIds.has(b.id)).length;
const byStatus = (status: string) => briefs.filter((b) => b.data.qualityStatus === status).length;
---

<BaseLayout
  title="Coverage roadmap"
  description={`The complete research plan: ${briefs.length} briefs across ${groups.length} categories, with queue status and published articles linked. ${writtenTotal} published so far.`}
  path="/roadmap"
>
  <header class="shell pt-10">
    <p class="eyebrow">Transparency</p>
    <h1 class="mt-2 max-w-3xl font-serif text-4xl font-semibold tracking-tight">Everything planned, and exactly what is done</h1>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-[var(--color-ink-muted)]">
      The library is built from {briefs.length} briefs, each with its own scope, required sources and dependencies.
      {writtenTotal} {writtenTotal === 1 ? 'is' : 'are'} published; the rest are queued in the open. An associated article link
      appears only when the article is complete — no placeholder pages, no thin stubs counting toward coverage.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <span class="badge badge-gain">published: {writtenTotal}</span>
      <span class="badge badge-neutral">queued: {briefs.length - writtenTotal}</span>
      <span class="badge badge-brass">automated checks passed: {byStatus('automated-checks-passed')}</span>
      <span class="badge badge-caution">awaiting review: {byStatus('not-reviewed')}</span>
    </div>
  </header>

  <div class="shell mt-12 space-y-8 pb-16">
    {
      groups.map(({ cat, briefs: list }) => {
        const done = list.filter((b) => publishedIds.has(b.id)).length;
        return (
          <section class="card p-0" aria-labelledby={`roadmap-${cat.id}`}>
            <details open={done > 0}>
              <summary class="flex cursor-pointer list-none flex-wrap items-center gap-2 px-5 py-4 [&::-webkit-details-marker]:hidden">
                <h2 id={`roadmap-${cat.id}`} class="m-0 font-serif text-xl font-semibold">{cat.name}</h2>
                <span class="badge badge-neutral">{done}/{list.length} published</span>
                <span class="ml-auto text-xs text-[var(--color-link)]">toggle</span>
              </summary>
              <ul class="divide-y divide-[var(--color-border)] border-t border-[var(--color-border)]" role="list">
                {list.map((brief) => {
                  const done = publishedIds.has(brief.id);
                  return (
                    <li id={`brief-${brief.id}`} class="grid scroll-mt-24 gap-1 px-5 py-3 sm:grid-cols-[4.5rem_minmax(0,1fr)]">
                      <span class="font-mono text-2xs uppercase tracking-[0.05em] text-[var(--color-ink-faint)]">
                        P{brief.data.priority} · {brief.data.difficulty.slice(0, 4)}
                      </span>
                      <span>
                        <span class="block text-sm font-medium text-[var(--color-ink-body)]">
                          {done ? <a href={articleHref(brief.id)} class="text-[var(--color-link)] no-underline hover:underline">{brief.data.title} ↗</a> : brief.data.title}
                        </span>
                        <span class="mt-0.5 block text-xs leading-5 text-[var(--color-ink-muted)]">{brief.data.brief}</span>
                        <span class="mt-1 flex flex-wrap gap-2 font-mono text-2xs uppercase tracking-[0.04em] text-[var(--color-ink-faint)]">
                          <span>{done ? 'published' : brief.data.status.replaceAll('-', ' ')}</span>
                          <span>{formatCount(brief.data.requiredSources.length, 'source')} required</span>
                          {brief.data.dependencies.length > 0 && <span>after {brief.data.dependencies.length} briefs</span>}
                        </span>
                      </span>
                    </li>
                  );
                })}
              </ul>
            </details>
          </section>
        );
      })
    }
  </div>

  <p class="shell pb-16 text-xs leading-5 text-[var(--color-ink-faint)]">
    Queue mechanics: briefs are worked in priority order within each category, dependency-first. An article publishes
    only when it clears automated checks (source links resolve, calculators run, tests pass) and editorial review. See
    the <a href={href('/about/methodology')} class="text-[var(--color-link)] underline decoration-1 underline-offset-2">methodology</a>.
  </p>
</BaseLayout>
