---
/**
 * /tax — the tax-rule registry rendered as a dated reference.
 *
 * Every rule shows its provision, effective date, verification date and review
 * status. Rules never go unlabelled: if a rule is pending re-verification,
 * the page says so.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../lib/url';
import { formatDate } from '../../lib/format';
import definitions from '../../data/calculators/definitions.json';

const rules = await getCollection('taxRules');
const sources = await getCollection('sources');
const sourceById = new Map(sources.map((s) => [s.id, s.data]));

const byAssetClass = new Map<string, typeof rules>();
for (const rule of rules) {
  const list = byAssetClass.get(rule.data.assetClass) ?? [];
  list.push(rule);
  byAssetClass.set(rule.data.assetClass, list);
}
const groups = [...byAssetClass.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const taxCalculators = definitions.filter((d) => d.category === 'tax');
const verified = rules.filter((r) => r.data.reviewStatus === 'verified').length;
const latestVerification = rules
  .map((r) => new Date(r.data.verifiedAt).getTime())
  .reduce((max, t) => Math.max(max, t), 0);
---

<BaseLayout
  title="Taxation reference"
  description={`${rules.length} dated Indian tax rules for investments — capital gains, interest, dividends and business income — each with its provision, effective date and verification date.`}
  path="/tax"
>
  <header class="shell pt-10">
    <p class="eyebrow">Tax reference</p>
    <h1 class="mt-2 max-w-3xl font-serif text-4xl font-semibold tracking-tight">Every tax rule, dated and sourced</h1>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-[var(--color-ink-muted)]">
      {rules.length} rules covering the tax treatment of every investment avenue on this site. Each states the
      provision it rests on, the date it took effect, and when it was last verified against the primary source —
      most recently {formatDate(new Date(latestVerification))}. {verified} of {rules.length} rules are fully verified;
      the rest carry their status openly.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      {
        taxCalculators.map((calc) => (
          <a href={href(`/calculators/${calc.id}`)} class="badge badge-brass no-underline">{calc.name}</a>
        ))
      }
    </div>
  </header>

  <section class="shell mt-10" aria-labelledby="framework-heading">
    <h2 id="framework-heading" class="eyebrow">How to read this page</h2>
    <div class="mt-4 grid gap-4 lg:grid-cols-3">
      <div class="card p-5">
        <p class="text-sm font-semibold text-[var(--color-ink-body)]">Rules are dated, not assumed</p>
        <p class="mt-1.5 text-sm leading-6 text-[var(--color-ink-muted)]">
          Indian tax law changes with each Finance Act. Every rule here states its effective date; where Parliament
          has passed a replacement Act, the rule says which Act governs which period.
        </p>
      </div>
      <div class="card p-5">
        <p class="text-sm font-semibold text-[var(--color-ink-body)]">Rates are marginal, not average</p>
        <p class="mt-1.5 text-sm leading-6 text-[var(--color-ink-muted)]">
          Headline rates apply to the next rupee, not to all income. Surcharge and cess stack on top. Use the
          calculators above for your actual numbers rather than multiplying income by a headline rate.
        </p>
      </div>
      <div class="card p-5">
        <p class="text-sm font-semibold text-[var(--color-ink-body)]">A reference, not advice</p>
        <p class="mt-1.5 text-sm leading-6 text-[var(--color-ink-muted)]">
          This page organises the law; it does not apply it to your facts. For filing decisions, check the
          <a href={href('/sources')} class="text-[var(--color-link)] underline decoration-1 underline-offset-2">cited primary sources</a>
          or a qualified professional.
        </p>
      </div>
    </div>
  </section>

  <div class="shell mt-12 space-y-12 pb-16">
    {
      groups.map(([assetClass, list]) => (
        <section aria-labelledby={`tax-${assetClass.slice(0, 24).replaceAll(/\W+/g, '-').toLowerCase()}`}>
          <h2 class="border-b border-[var(--color-border)] pb-3 font-serif text-2xl font-semibold">{assetClass}</h2>
          <div class="mt-5 space-y-4">
            {list.map((rule) => {
              const d = rule.data;
              return (
                <article class="card p-0">
                  <div class="flex flex-wrap items-center gap-2 border-b border-[var(--color-border)] px-5 py-3">
                    <h3 class="m-0 font-sans text-sm font-semibold text-[var(--color-ink-body)]">{d.title}</h3>
                    <span class={`badge ${d.reviewStatus === 'verified' ? 'badge-gain' : 'badge-caution'}`}>{d.reviewStatus.replaceAll('-', ' ')}</span>
                    <span class="badge badge-neutral">{d.incomeType}</span>
                    <span class="ml-auto font-mono text-2xs text-[var(--color-ink-faint)]">
                      {d.assessmentYear} · effective {formatDate(d.effectiveFrom)} · verified {formatDate(d.verifiedAt)}
                    </span>
                  </div>
                  <div class="grid gap-4 px-5 py-4 text-sm leading-6 md:grid-cols-2">
                    <div class="space-y-2.5">
                      <p class="m-0"><span class="eyebrow block">Rate</span>{d.taxRate}</p>
                      <p class="m-0"><span class="eyebrow block">Exemption / threshold</span>{d.exemptionLimit}</p>
                      {d.holdingPeriodRule && <p class="m-0"><span class="eyebrow block">Holding period</span>{d.holdingPeriodRule}</p>}
                    </div>
                    <div class="space-y-2.5">
                      <p class="m-0"><span class="eyebrow block">Surcharge & cess</span>{d.surchargeRule} {d.cessRule}</p>
                      {d.setOffRule && <p class="m-0"><span class="eyebrow block">Set-off</span>{d.setOffRule}</p>}
                      <p class="m-0"><span class="eyebrow block">Provision</span>{d.provision}</p>
                    </div>
                    {d.conditions.length > 0 && (
                      <div class="md:col-span-2">
                        <span class="eyebrow block">Conditions</span>
                        <ul class="mt-1 list-disc space-y-1 pl-5 text-sm">
                          {d.conditions.map((condition) => (
                            <li>{condition}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                    <details class="md:col-span-2">
                      <summary class="cursor-pointer font-sans text-sm font-medium text-[var(--color-link)]">Worked example</summary>
                      <p class="mt-2 text-sm leading-6 text-[var(--color-ink-muted)]">{d.workedExampleSummary}</p>
                    </details>
                    {d.notes && <p class="m-0 text-xs leading-5 text-[var(--color-ink-faint)] md:col-span-2">{d.notes}</p>}
                    <p class="m-0 flex flex-wrap gap-2 md:col-span-2">
                      {d.sourceIds.map((id) => (
                        <a href={sourceById.get(id)?.url ?? href('/sources')} rel="noopener noreferrer" class="text-xs text-[var(--color-link)] underline decoration-1 underline-offset-2">
                          {sourceById.get(id)?.publisher ?? id}
                        </a>
                      ))}
                    </p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
