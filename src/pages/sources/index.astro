---
/**
 * /sources — the complete source registry, classified by tier.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';

const sources = await getCollection('sources');

const TIERS = [
  { id: 'primary-official', label: 'Primary official', blurb: 'Government, regulator or statutory publications — the evidence of record.' },
  { id: 'audited-disclosure', label: 'Audited disclosure', blurb: 'Filed audited financials, exchange disclosures and scheme documents.' },
  { id: 'academic', label: 'Academic', blurb: 'Peer-reviewed or working papers used for theory and long-horizon evidence.' },
  { id: 'reputable-secondary', label: 'Reputable secondary', blurb: 'Well-edited general references — used for context, never as sole evidence for a figure.' },
  { id: 'industry-research', label: 'Industry research', blurb: 'Industry bodies and research houses; interests of the publisher are considered.' },
  { id: 'market-commentary', label: 'Market commentary', blurb: 'Press and analyst commentary — treated as claims to verify, not as evidence.' },
  { id: 'unverified', label: 'Unverified', blurb: 'Points where no reliable source was found; recorded so the gap is visible, never used to certify a number.' },
] as const;

const groups = TIERS.map((tier) => ({
  ...tier,
  items: sources
    .filter((s) => s.data.tier === tier.id)
    .sort((a, b) => a.data.publisher.localeCompare(b.data.publisher)),
})).filter((group) => group.items.length > 0);

const lastAccess = sources
  .map((s) => new Date(s.data.accessedAt).getTime())
  .reduce((max, t) => Math.max(max, t), 0);
---

<BaseLayout
  title="Source registry"
  description={`${sources.length} sources, classified by tier — where every figure, tax rule and regulatory claim on this site comes from.`}
  path="/sources"
>
  <header class="shell pt-10">
    <p class="eyebrow">Evidence</p>
    <h1 class="mt-2 max-w-3xl font-serif text-4xl font-semibold tracking-tight">{sources.length} sources, one tier system</h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-[var(--color-ink-muted)]">
      Every claim on Arthanomy cites from this registry. Sources are classified by what they can actually establish:
      a statutory text settles a legal question; an analyst note does not. Most recently accessed {formatDate(new Date(lastAccess))}.
    </p>
  </header>

  <div class="shell mt-12 space-y-12 pb-16">
    {
      groups.map((group) => (
        <section aria-labelledby={`tier-${group.id}`}>
          <div class="border-b border-[var(--color-border)] pb-3">
            <h2 id={`tier-${group.id}`} class="font-serif text-2xl font-semibold">
              {group.label}
              <span class="ml-2 font-mono text-sm font-normal text-[var(--color-ink-faint)]">{group.items.length}</span>
            </h2>
            <p class="mt-1 text-sm text-[var(--color-ink-muted)]">{group.blurb}</p>
          </div>
          <ul class="mt-5 grid gap-4 lg:grid-cols-2" role="list">
            {group.items.map((source) => (
              <li class="card p-5">
                <p class="text-sm font-semibold leading-snug text-[var(--color-ink-body)]">{source.data.title}</p>
                <p class="mt-1 text-xs text-[var(--color-ink-muted)]">
                  {source.data.publisher}
                  {source.data.documentDate ? ` · document dated ${formatDate(source.data.documentDate)}` : ''}
                  {` · accessed ${formatDate(source.data.accessedAt)}`}
                </p>
                <p class="mt-2 text-xs leading-5 text-[var(--color-ink-muted)]">
                  <span class="font-medium uppercase tracking-[0.05em] text-[var(--color-ink-faint)]">Used for </span>
                  {source.data.supports}
                </p>
                {source.data.note && <p class="mt-1.5 text-xs leading-5 text-[var(--color-ink-faint)]">{source.data.note}</p>}
                {source.data.url && (
                  <a href={source.data.url} rel="noopener noreferrer" class="mt-2.5 inline-block text-xs text-[var(--color-link)] underline decoration-1 underline-offset-2">
                    Open source ↗
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
