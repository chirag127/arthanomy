---
/**
 * BaseHead — every page's <head>.
 *
 * Loads fonts, design tokens, KaTeX, the theme bootstrap (inline, before paint,
 * to avoid a flash of the wrong theme) and the SEO/social metadata.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { site } from '../config/site';
import { absoluteUrl } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Path on this site, e.g. "/library/foo". */
  path: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, type = 'website', publishedTime, noindex = false, jsonLd } = Astro.props;

const pageTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} · ${site.name}`;
const canonical = absoluteUrl(path, Astro.site ?? undefined);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: canonical,
  description: site.description,
  author: { '@type': 'Person', name: site.author.name, url: site.author.facebook },
};
const structuredData = jsonLd ?? defaultJsonLd;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#101a24" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f7f9fb" media="(prefers-color-scheme: light)" />
<meta name="author" content={site.author.name} />

<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_IN" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — latest research`} href={`${base}/rss.xml`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />

<script is:inline>
  // Theme bootstrap: stored preference, else OS preference. Runs before paint.
  (() => {
    try {
      const stored = localStorage.getItem('arthanomy-theme');
      const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    } catch {
      /* private mode without storage: fall back to light */
    }
  })();
</script>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
