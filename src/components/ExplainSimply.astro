---
/**
 * ExplainSimply — the plain-language twin of a technical passage.
 * Native <details> so it works without JavaScript and prints open.
 */
interface Props {
  title?: string;
}
const { title = 'Explain it simply' } = Astro.props;
---

<details class="not-prose callout callout-plain group my-6">
  <summary class="callout-title cursor-pointer list-none [&::-webkit-details-marker]:hidden">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="transition-transform group-open:rotate-90">
      <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {title}
  </summary>
  <div class="mt-2 font-sans text-sm leading-6">
    <slot />
  </div>
</details>
