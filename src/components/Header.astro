---
/**
 * Header — sticky navigation, command palette trigger and theme toggle.
 * Dropdowns are CSS-only (hover on pointer devices, focus-within for keyboard);
 * the mobile menu is a <details> element so it works without JavaScript.
 */
import { site, primaryNav } from '../config/site';
import { href } from '../lib/url';

const nav = primaryNav;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname;
const isActive = (target: string) =>
  current === href(target) || (target !== '/' && current.startsWith(href(target)));
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-surface)]/92 backdrop-blur supports-[backdrop-filter]:bg-[var(--color-surface)]/80">
  <div class="shell flex h-16 items-center gap-4">
    <a href={href('/')} class="flex items-baseline gap-2.5 no-underline" aria-label={`${site.name} home`}>
      <span class="font-serif text-[1.35rem] font-semibold tracking-tight text-[var(--color-ink-950)] dark:text-[var(--color-ink-50)]">
        {site.wordmark}
      </span>
      <span class="hidden text-2xs font-medium tracking-[0.08em] text-[var(--color-ink-faint)] uppercase lg:inline">
        Science of Wealth · Reality of Risk
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <div class="group relative">
            <a
              href={href(item.href)}
              class:list={[
                'inline-flex items-center gap-1 rounded-md px-2.5 py-2 text-sm font-medium no-underline transition-colors',
                isActive(item.href)
                  ? 'text-[var(--color-accent-strong)]'
                  : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink-body)]',
              ]}
              aria-haspopup={item.children && item.children.length > 0 ? 'true' : undefined}
            >
              {item.label}
              {item.children && item.children.length > 0 && (
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="mt-0.5 opacity-60">
                  <path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              )}
            </a>
            {item.children && item.children.length > 0 && (
              <div class="invisible absolute left-0 top-full z-50 w-72 pt-1 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <div class="card overflow-hidden p-1.5">
                  {item.children.map((child) => (
                    <a
                      href={href(child.href)}
                      class="block rounded-md px-3 py-2 no-underline hover:bg-[var(--color-surface-2)]"
                    >
                      <span class="block text-sm font-medium text-[var(--color-ink-body)]">{child.label}</span>
                      {child.description && (
                        <span class="mt-0.5 block text-xs leading-5 text-[var(--color-ink-faint)]">{child.description}</span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5 lg:ml-2">
      <button
        type="button"
        id="search-trigger"
        class="hidden items-center gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-surface-2)] px-3 py-1.5 text-sm text-[var(--color-ink-faint)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-ink-body)] sm:flex"
        aria-label="Search Arthanomy (opens command palette)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <span>Search</span>
        <kbd class="rounded border border-[var(--color-border)] bg-[var(--color-surface)] px-1.5 py-0.5 font-mono text-2xs">Ctrl K</kbd>
      </button>

      <button
        type="button"
        id="theme-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-border)] text-[var(--color-ink-muted)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-ink-body)]"
        aria-label="Toggle colour theme"
      >
        <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" stroke-linecap="round" />
        </svg>
        <svg class="theme-icon-dark hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round" />
        </svg>
      </button>

      <details class="mobile-menu relative lg:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-[var(--color-border)] text-[var(--color-ink-muted)] [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="card absolute right-0 top-full z-50 mt-2 w-72 p-2">
          {
            nav.map((item) => (
              <div class="py-1">
                <a href={href(item.href)} class="block rounded-md px-3 py-2 text-sm font-semibold no-underline text-[var(--color-ink-body)] hover:bg-[var(--color-surface-2)]">
                  {item.label}
                </a>
                {item.children?.map((child) => (
                  <a href={href(child.href)} class="block rounded-md px-3 py-1.5 pl-6 text-sm no-underline text-[var(--color-ink-muted)] hover:bg-[var(--color-surface-2)]">
                    {child.label}
                  </a>
                ))}
              </div>
            ))
          }
          <div class="hairline my-1.5"></div>
          <a href={href('/glossary')} class="block rounded-md px-3 py-2 text-sm no-underline text-[var(--color-ink-muted)] hover:bg-[var(--color-surface-2)]">Glossary</a>
          <a href={href('/sources')} class="block rounded-md px-3 py-2 text-sm no-underline text-[var(--color-ink-muted)] hover:bg-[var(--color-surface-2)]">Sources</a>
          <a href={href('/roadmap')} class="block rounded-md px-3 py-2 text-sm no-underline text-[var(--color-ink-muted)] hover:bg-[var(--color-surface-2)]">Roadmap</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;
    const sync = () => {
      const dark = document.documentElement.classList.contains('dark');
      toggle.querySelector('.theme-icon-light')?.classList.toggle('hidden', dark);
      toggle.querySelector('.theme-icon-dark')?.classList.toggle('hidden', !dark);
      toggle.setAttribute('aria-pressed', String(dark));
    };
    sync();
    toggle.addEventListener('click', () => {
      const dark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', dark);
      try {
        localStorage.setItem('arthanomy-theme', dark ? 'dark' : 'light');
      } catch {
        /* storage unavailable */
      }
      sync();
    });

    // Close the mobile <details> when a link inside it is clicked.
    const menu = document.querySelector('.mobile-menu');
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
  })();
</script>
